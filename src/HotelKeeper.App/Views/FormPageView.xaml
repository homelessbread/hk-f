<UserControl x:Class="HotelKeeper.App.Views.Shared.FormPageView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:v="clr-namespace:HotelKeeper.App.Views.Shared">
    <Grid Margin="14,6,6,6">
        <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
        <v:PageHeader/>
        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
            <Border Style="{StaticResource Card}" MaxWidth="560" HorizontalAlignment="Left" Padding="24">
                <StackPanel>
                    <ItemsControl ItemsSource="{Binding Fields}" Focusable="False">
                        <ItemsControl.ItemTemplate><DataTemplate><v:FieldEditor/></DataTemplate></ItemsControl.ItemTemplate>
                    </ItemsControl>
                    <Button Content="{Binding SaveText}" Style="{StaticResource PrimaryBtn}" Command="{Binding SaveCommand}" HorizontalAlignment="Left" Margin="0,6,0,0" Padding="18,9"/>
                </StackPanel>
            </Border>
        </ScrollViewer>
    </Grid>
</UserControl>
