<Window x:Class="HotelKeeper.App.Views.ShellWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Hotel Keeper" Width="1360" Height="820" MinWidth="1000" MinHeight="620" WindowStartupLocation="CenterScreen">
    <Grid Margin="10">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="268"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <Border Grid.Column="0" Background="{StaticResource SidebarBrush}" CornerRadius="16" Margin="0,0,10,0" Padding="14">
            <DockPanel>
                <StackPanel DockPanel.Dock="Top">
                    <Grid Margin="2,2,2,12">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <Border Width="42" Height="42" CornerRadius="21" Background="{StaticResource AccentBrush}">
                            <TextBlock Text="{Binding Initials}" FontWeight="SemiBold" FontSize="15" Foreground="White" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <StackPanel Grid.Column="1" Margin="10,0,0,0" VerticalAlignment="Center">
                            <TextBlock Text="{Binding UserName}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis"/>
                            <TextBlock Text="{Binding Subtitle}" Style="{StaticResource Muted}" FontSize="12" TextTrimming="CharacterEllipsis"/>
                        </StackPanel>
                        <Button Grid.Column="2" Style="{StaticResource RailBtn}" Command="{Binding SignOutCommand}" ToolTip="Sign out" VerticalAlignment="Center">
                            <Path Data="{Binding Source=log-out, Converter={StaticResource IconConv}}" Stroke="{StaticResource TextBrush}" StrokeThickness="1.7" Width="18" Height="18" Stretch="Uniform"
                                  StrokeLineJoin="Round" StrokeStartLineCap="Round" StrokeEndLineCap="Round"/>
                        </Button>
                    </Grid>
                    <TextBox Text="{Binding NavSearch, UpdateSourceTrigger=PropertyChanged}" Margin="0,0,0,10" ToolTip="Filter the menu"/>
                </StackPanel>

                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <ItemsControl ItemsSource="{Binding Groups}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <StackPanel Margin="0,0,0,8" Visibility="{Binding IsVisible, Converter={StaticResource BoolToVis}}">
                                    <Button Command="{Binding ToggleCommand}" Style="{StaticResource NavBtn}">
                                        <TextBlock Text="{Binding Title}" Style="{StaticResource Muted}" FontWeight="SemiBold" FontSize="12"/>
                                    </Button>
                                    <ItemsControl ItemsSource="{Binding Items}" Visibility="{Binding IsExpanded, Converter={StaticResource BoolToVis}}">
                                        <ItemsControl.ItemTemplate>
                                             <DataTemplate>
                                                <Button Command="{Binding Command}" Visibility="{Binding IsVisible, Converter={StaticResource BoolToVis}}">
                                                    <Button.Style>
                                                        <Style TargetType="Button" BasedOn="{StaticResource NavBtn}">
                                                            <Style.Triggers>
                                                                <DataTrigger Binding="{Binding IsSelected}" Value="True">
                                                                    <Setter Property="Template">
                                                                        <Setter.Value>
                                                                            <ControlTemplate TargetType="Button">
                                                                                <Border Background="{StaticResource SelectedBrush}" CornerRadius="8" Padding="10,8" Effect="{StaticResource SoftShadow}"><ContentPresenter/></Border>
                                                                            </ControlTemplate>
                                                                        </Setter.Value>
                                                                    </Setter>
                                                                </DataTrigger>
                                                            </Style.Triggers>
                                                        </Style>
                                                    </Button.Style>
                                                    <Grid>
                                                        <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                                        <Path Data="{Binding Icon, Converter={StaticResource IconConv}}" Stroke="{StaticResource TextBrush}" StrokeThickness="1.6" Width="17" Height="17" Stretch="Uniform"
                                                              StrokeLineJoin="Round" StrokeStartLineCap="Round" StrokeEndLineCap="Round"/>
                                                        <TextBlock Grid.Column="1" Text="{Binding Title}" Margin="10,0,0,0" FontSize="13.5"/>
                                                        <Border Grid.Column="2" Background="{StaticResource AccentDarkBrush}" CornerRadius="9" Padding="7,1" Visibility="{Binding HasBadge, Converter={StaticResource BoolToVis}}">
                                                            <TextBlock Text="{Binding Badge}" Foreground="White" FontSize="11"/>
                                                        </Border>
                                                    </Grid>
                                                </Button>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                </StackPanel>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </ScrollViewer>
            </DockPanel>
        </Border>

        <Grid Grid.Column="1">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <Border Grid.Row="0" Margin="0,0,0,6">
                <DockPanel LastChildFill="False">
                    <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
                        <Button Style="{StaticResource RailBtn}" Command="{Binding ToggleThemeCommand}" ToolTip="Toggle dark / light theme" Margin="0,0,6,0">
                            <Path Data="{Binding ThemeIcon, Converter={StaticResource IconConv}}" Stroke="{StaticResource TextBrush}" StrokeThickness="1.7" Width="18" Height="18" Stretch="Uniform"
                                  StrokeLineJoin="Round" StrokeStartLineCap="Round" StrokeEndLineCap="Round"/>
                        </Button>
                        <Grid>
                            <Button Style="{StaticResource RailBtn}" Command="{Binding NotificationsCommand}" ToolTip="Notifications">
                                <Path Data="{Binding Source=bell, Converter={StaticResource IconConv}}" Stroke="{StaticResource TextBrush}" StrokeThickness="1.7" Width="18" Height="18" Stretch="Uniform"
                                      StrokeLineJoin="Round" StrokeStartLineCap="Round" StrokeEndLineCap="Round"/>
                            </Button>
                            <Ellipse Width="8" Height="8" Fill="{StaticResource AccentBrush}" HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,6,6,0" IsHitTestVisible="False"
                                     Visibility="{Binding HasUnread, Converter={StaticResource BoolToVis}}"/>
                        </Grid>
                    </StackPanel>
                </DockPanel>
            </Border>

            <Border Grid.Row="1" Style="{StaticResource ErrorBanner}" Visibility="{Binding HasBootError, Converter={StaticResource BoolToVis}}">
                <TextBlock Text="{Binding BootError}" TextWrapping="Wrap" Foreground="{StaticResource DangerBrush}"/>
            </Border>
            <ContentControl Grid.Row="2" Content="{Binding Current}" IsTabStop="False"/>
        </Grid>
    </Grid>
</Window>