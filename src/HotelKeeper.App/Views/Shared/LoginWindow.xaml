<Window x:Class="HotelKeeper.App.Views.LoginWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Hotel Keeper - Sign in" Width="900" Height="600" MinWidth="720" MinHeight="520" WindowStartupLocation="CenterScreen">
    <Grid Margin="16">
        <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="1.1*"/></Grid.ColumnDefinitions>

        <Border Background="{StaticResource RailBrush}" CornerRadius="16" Margin="0,0,16,0" Padding="36">
            <Grid>
                <StackPanel VerticalAlignment="Center">
                    <Border Width="52" Height="52" CornerRadius="14" Background="{StaticResource AccentBrush}" HorizontalAlignment="Left">
                        <Path Data="{Binding Source=bed, Converter={StaticResource IconConv}}" Stroke="#242424" StrokeThickness="1.8" Width="26" Height="26" Stretch="Uniform"
                              StrokeLineJoin="Round" StrokeStartLineCap="Round" StrokeEndLineCap="Round"/>
                    </Border>
                    <TextBlock Text="Hotel Keeper" Foreground="White" FontSize="34" FontWeight="SemiBold" Margin="0,22,0,6"/>
                    <TextBlock Text="Rooms, housekeeping, reservations and guest requests in one place." Foreground="#BDBDBD" FontSize="14" TextWrapping="Wrap"/>
                </StackPanel>
            </Grid>
        </Border>

        <Border Grid.Column="1" Style="{StaticResource Card}" Padding="36" VerticalAlignment="Center" MaxWidth="420">
            <StackPanel>
                <TextBlock Text="Welcome back" Style="{StaticResource PageTitle}"/>
                <TextBlock Text="Sign in with your username and password." Style="{StaticResource Muted}" Margin="0,4,0,20"/>

                <Border Style="{StaticResource ErrorBanner}" Visibility="{Binding HasError, Converter={StaticResource BoolToVis}}">
                    <TextBlock Text="{Binding ErrorMessage}" TextWrapping="Wrap" Foreground="{StaticResource DangerBrush}"/>
                </Border>
                <Border Style="{StaticResource OkBanner}" Visibility="{Binding HasInfo, Converter={StaticResource BoolToVis}}">
                    <TextBlock Text="{Binding InfoMessage}" TextWrapping="Wrap"/>
                </Border>

                <TextBlock Text="Username" Style="{StaticResource Muted}" Margin="0,0,0,4"/>
                <TextBox x:Name="UserBox" Text="{Binding Username, UpdateSourceTrigger=PropertyChanged}" Margin="0,0,0,12"/>
                <TextBlock Text="Password" Style="{StaticResource Muted}" Margin="0,0,0,4"/>
                <PasswordBox x:Name="PasswordBox" Margin="0,0,0,18"/>

                <Button Content="Sign in" Style="{StaticResource PrimaryBtn}" Command="{Binding SignInCommand}" IsDefault="True" Margin="0,0,0,10" Padding="14,10"/>
                <Button Content="Retry database connection" Style="{StaticResource Btn}" Command="{Binding RetryCommand}" Margin="0"
                        Visibility="{Binding NeedsRetry, Converter={StaticResource BoolToVis}}"/>

                <StackPanel Orientation="Horizontal" Margin="0,14,0,0" Visibility="{Binding IsBusy, Converter={StaticResource BoolToVis}}">
                    <ProgressBar IsIndeterminate="True" Width="80" Height="6" VerticalAlignment="Center"/>
                    <TextBlock Text="{Binding BusyText}" Style="{StaticResource Muted}" Margin="10,0,0,0"/>
                </StackPanel>
            </StackPanel>
        </Border>
    </Grid>
</Window>
