<Application x:Class="HotelKeeper.App.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:conv="clr-namespace:HotelKeeper.App.Converters"
             xmlns:vm="clr-namespace:HotelKeeper.ViewModels;assembly=HotelKeeper.ViewModels"
             xmlns:views="clr-namespace:HotelKeeper.App.Views.Shared">
    <Application.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="Resources/Styles/Theme.xaml"/>
                <ResourceDictionary Source="Resources/Icons/Icons.xaml"/>
            </ResourceDictionary.MergedDictionaries>

            <BooleanToVisibilityConverter x:Key="BoolToVis"/>
            <conv:InverseBoolToVisibilityConverter x:Key="InvBoolToVis"/>
            <conv:IconConverter x:Key="IconConv"/>
            <conv:BadgeBrushConverter x:Key="BadgeBrush"/>
            <conv:TextToVisibilityConverter x:Key="TextToVis"/>

           
            <DataTemplate DataType="{x:Type vm:ListPageViewModel}"><views:ListPageView/></DataTemplate>
            <DataTemplate DataType="{x:Type vm:FormPageViewModel}"><views:FormPageView/></DataTemplate>
            <DataTemplate DataType="{x:Type vm:DashboardPageViewModel}"><views:DashboardPageView/></DataTemplate>
        </ResourceDictionary>
    </Application.Resources>
</Application>
