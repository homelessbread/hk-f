<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <RootNamespace>HotelKeeper</RootNamespace>
  </PropertyGroup>

  <ItemGroup Condition="'$(DbShim)' != 'true'">
    <PackageReference Include="Microsoft.CodeAnalysis.CSharp" Version="5.9.0" />
    <PackageReference Include="MySqlConnector" Version="2.3.7" />
  </ItemGroup>

  
  <ItemGroup Condition="'$(DbShim)' == 'true'">
    <Compile Include="..\..\tests\DbShim\*.cs" />
    <None Include="..\..\tests\DbShim\bridge.py" Link="bridge.py" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

  <ItemGroup>
    <EmbeddedResource Include="..\..\database\schema.sql" LogicalName="schema.sql" />
  </ItemGroup>

</Project>
